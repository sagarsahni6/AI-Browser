# ==============================================================================
# AI Browser - Backend Environment Configuration Example
# Copy this file to .env and configure your desired AI providers and settings.
# ==============================================================================

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=false
SECRET_TOKEN=change-me-in-production

# Default AI Provider (nvidia_nim | openai_compatible | anthropic | google_gemini | groq | ollama)
DEFAULT_PROVIDER=nvidia_nim

# AI Provider: NVIDIA NIM (Primary / Recommended)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_REASONING_MODEL=mistralai/mistral-large-4-1t-a52b

# AI Provider: OpenAI-Compatible Fallback
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# AI Provider: Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# AI Provider: Google Gemini
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# AI Provider: Groq (Ultra-Fast Inference)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# AI Provider: Ollama (Local Offline Models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Browser Use Integration
BROWSER_USE_API_KEY=
BROWSER_USE_CDP_URL=http://127.0.0.1:9222
DEFAULT_AGENT_ENGINE=browser_use

# Local Database
DATABASE_URL=sqlite+aiosqlite:///./ai_browser.db
