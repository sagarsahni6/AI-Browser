{
  "name": "ai-browser",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade AI-powered autonomous desktop browser",
  "workspaces": [
    "apps/*",
    "shared"
  ],
  "scripts": {
    "desktop:dev": "npm run dev --workspace=@ai-browser/desktop",
    "desktop:build": "npm run build --workspace=@ai-browser/desktop",
    "desktop:test": "npm run test --workspace=@ai-browser/desktop",
    "backend:dev": "powershell -ExecutionPolicy Bypass -File scripts/dev-backend.ps1",
    "backend:test": "powershell -ExecutionPolicy Bypass -File scripts/test-backend.ps1",
    "test": "npm run desktop:test"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
